# syntax=docker/dockerfile:1
# 控制台镜像：先构建 Vue 前端，再把静态资源嵌入 Go 二进制。
FROM node:22-alpine AS web
WORKDIR /web
COPY web/package.json ./
RUN npm install --no-audit --no-fund
COPY web .
RUN npm run build

FROM golang:1.24 AS builder
ARG GOPROXY=https://goproxy.cn,direct
ENV CGO_ENABLED=0 \
    GOPROXY=${GOPROXY}
WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY api api
COPY cmd cmd
COPY internal internal
COPY --from=web /cmd/controlplane/webdist cmd/controlplane/webdist
RUN go build -trimpath -ldflags="-s -w" -o controlplane ./cmd/controlplane

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/controlplane /controlplane
USER 65532:65532
ENTRYPOINT ["/controlplane"]